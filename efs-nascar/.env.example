# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For server-side operations with elevated privileges
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NASCAR API Configuration (RapidAPI)
# Get your API key at: https://rapidapi.com/belchiorarkad-FqvHs2EDOtP/api/nascar-motorsport-api
# This enables automatic race results fetching
RAPIDAPI_KEY=your-rapidapi-key
# Alternative: SPORTRADAR_API_KEY also works
