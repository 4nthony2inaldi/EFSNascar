# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For server-side operations with elevated privileges
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NASCAR API Configuration (Sportradar)
# Get your free trial API key at: https://developer.sportradar.com/
# This enables automatic race results fetching
SPORTRADAR_API_KEY=your-sportradar-api-key
